---
const labels = ['User Needs', 'System Design', 'Development', 'Real-World Impact'];
---
<div class="hero-systems" role="img" aria-label="A journey from Astana to Boston becomes four connected layers: User Needs, System Design, Development, and Real-World Impact.">
  <canvas aria-hidden="true"></canvas>
  <svg viewBox="0 35 635 540" aria-hidden="true" class="system-stack">
    <defs>
      <linearGradient id="layer-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#ff74b2" stop-opacity=".13"/><stop offset="1" stop-color="#ff9bc8" stop-opacity=".6"/></linearGradient>
      <filter id="pink-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="5"/></filter>
      <radialGradient id="stack-halo"><stop stop-color="#ef579b" stop-opacity=".28"/><stop offset="1" stop-color="#ef579b" stop-opacity="0"/></radialGradient>
    </defs>
    <ellipse class="system-details" cx="255" cy="295" rx="230" ry="235" fill="url(#stack-halo)"/>
    <g class="floating-stack">
      <g class="system-details" stroke="#e67ca9" stroke-opacity=".12" fill="none">
        {Array.from({length:9},(_,i)=><><path d={`M${20+i*38} 480 L${300+i*25} 260`}/><path d={`M${20+i*38} 260 L${300+i*25} 480`}/></>)}
        <path d="M90 200V420M250 65V485M410 200V420M90 200L250 120L410 200L250 280Z M90 420L250 340L410 420L250 500Z"/>
      </g>
      <path class="system-details" d="M225 60V550" stroke="#f9b0d0" stroke-width="1" stroke-dasharray="3 6" opacity=".65"/>
      {labels.map((label,i)=> <g class="system-layer" style={`--layer:${i}`}>
        <path d={`M225 ${95+i*100}L430 ${165+i*100}L225 ${235+i*100}L20 ${165+i*100}Z`} fill="url(#layer-fill)" stroke="#ff8ac2" stroke-width="1.5"/>
        <path d={`M20 ${165+i*100}L225 ${235+i*100}L430 ${165+i*100}`} fill="none" stroke="#ffb9db" stroke-width="7" filter="url(#pink-glow)"/>
        <path d={`M430 ${165+i*100}H452`} stroke="#f2a0c4" opacity=".7"/>
        <circle cx="225" cy={235+i*100} r="3" fill="#ffe3f1" class="connection-node"/><circle class="connection-node" cx="452" cy={165+i*100} r="3" fill="#ffc0dc"/>
        <text x="466" y={170+i*100} fill="#ffc0dc" font-size="17" letter-spacing=".6">{label === 'Real-World Impact' ? <><tspan x="466">REAL-WORLD</tspan><tspan x="466" dy="17">IMPACT</tspan></> : label.toUpperCase()}</text>
      </g>)}
      <g class="stack-core" transform="translate(-25,-20)" fill="#ffd9eb"><path d="M250 169L264 176V191L250 198L236 191V176Z" filter="url(#pink-glow)"/><path d="M250 169L264 176L250 183L236 176Z" fill="#fff0f8"/><path d="M236 176L250 183V198L236 191Z" fill="#fa8fbe"/><path d="M264 176L250 183V198L264 191Z" fill="#ffbbd9"/></g>
      <g class="system-details" fill="#ffb3d4">
        {[0,1,2,3,4,5].map(i=><circle class="ambient-particle" cx={45+(i%2)*370} cy={125+i*65} r="2" style={`--particle:${i}`}/>)}<circle cx="225" cy="60" r="3"/><circle cx="225" cy="550" r="3"/><circle cx="90" cy="270" r="3"/><circle cx="410" cy="340" r="3"/></g>
    </g>
  </svg>
</div>
<script>
import land from '../data/land.json';
import landDots from '../data/land-dots.json';
const host = document.querySelector<HTMLElement>('.hero-systems');
if (host) {
 const canvas = host.querySelector('canvas')!;
 const ctx = canvas.getContext('2d');
 const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
 let frame = 0;
 const stack=host.querySelector<SVGSVGElement>('.system-stack')!;
 const layers=Array.from(host.querySelectorAll<SVGGElement>('.system-layer'));
 const ease=(x:number)=>{x=Math.max(0,Math.min(1,x));return x*x*(3-2*x);};
 const finishLayers=()=>{layers.forEach(layer=>{layer.style.opacity='';layer.removeAttribute('transform');});};
 const stop = () => { cancelAnimationFrame(frame); ctx?.clearRect(0,0,canvas.width,canvas.height); canvas.hidden=true; host.classList.remove('is-playing'); finishLayers(); };
 if(ctx && !motion.matches) {
  host.classList.add('is-playing');
  const started=performance.now(); const D=Math.PI/180;
  // Extra horizontal drawing space preserves the globe and orbit trails beyond the column.
  const size=1600, centerY=490, radius=465;
  // Share the final layers' centerline with the Boston arrival and cube.
  const canvasBounds=canvas.getBoundingClientRect(),stackBounds=stack.getBoundingClientRect();
  const stackScale=Math.min(stackBounds.width/635,stackBounds.height/540);
  const centerX=(stackBounds.left+(stackBounds.width-635*stackScale)/2+225*stackScale-canvasBounds.left)*size/canvasBounds.width;
  const resize=()=>{const dpr=Math.min(devicePixelRatio||1,2);canvas.width=size*dpr;canvas.height=700*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);};resize();
  const project=(lon:number,lat:number,rotation:number,r=radius)=>{const a=(lon-rotation)*D,b=lat*D,tilt=42.36*D;const x=Math.cos(b)*Math.sin(a),y=Math.sin(b),z=Math.cos(b)*Math.cos(a);return {x:centerX+r*x,y:centerY-r*(y*Math.cos(tilt)-z*Math.sin(tilt)),z:y*Math.sin(tilt)+z*Math.cos(tilt)};};
  const dot=(x:number,y:number,r:number,alpha=1)=>{ctx.save();ctx.globalAlpha*=alpha;ctx.fillStyle='#ffd0e6';ctx.shadowColor='#ff4199';ctx.shadowBlur=26;ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fill();ctx.restore();};
  const tick=(now:number)=>{
   const t=(now-started)/1000;if(t>11.6){stop();return;}
   ctx.clearRect(0,0,size,700);const opacity=Math.min(1,t/.7)*Math.max(0,1-Math.max(0,t-5.0)/6);ctx.save();ctx.globalAlpha=opacity;
   const journey=ease((t-1.4)/2.6);
   const rotation=30+(-71.06-30)*journey;
   const sphere=ctx.createRadialGradient(centerX-65,centerY-110,25,centerX,centerY,radius);sphere.addColorStop(0,'#24141e');sphere.addColorStop(.82,'#100e13');sphere.addColorStop(1,'#b84177');ctx.fillStyle=sphere;ctx.beginPath();ctx.arc(centerX,centerY,radius,0,Math.PI*2);ctx.fill();
   ctx.lineWidth=1.2;ctx.strokeStyle='#fb85b9bb';ctx.shadowColor='#f94c9c';ctx.shadowBlur=20;ctx.beginPath();ctx.arc(centerX,centerY,radius,0,Math.PI*2);ctx.stroke();ctx.shadowBlur=0;
   // Inclined orbital paths and moving beacons, projected around the same sphere.
   for(let orbit=0;orbit<3;orbit++){
    const angle=-.45+orbit*.5;
    const point=(a:number)=>{const x=Math.cos(a)*(radius+20+orbit*14),y=Math.sin(a)*(100+orbit*25);return {x:centerX+x*Math.cos(angle)-y*Math.sin(angle),y:centerY-80+x*Math.sin(angle)+y*Math.cos(angle)};};
    ctx.beginPath();for(let j=0;j<=100;j++){const p=point(j/100*Math.PI*2);if(j===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y);}
    ctx.strokeStyle='#f97dbb55';ctx.lineWidth=1;ctx.shadowColor='#ff459c';ctx.shadowBlur=8;ctx.stroke();ctx.shadowBlur=0;
    for(let j=0;j<3;j++){const p=point(t*.24+j*2.1+orbit);dot(p.x,p.y,2.5,.8);}
   }
   // Latitude/longitude points establish depth without a WebGL dependency.
   for(let lat=-80;lat<=80;lat+=5)for(let lon=-180;lon<180;lon+=4){const p=project(lon,lat,rotation);if(p.z>0){ctx.fillStyle=`rgba(235,117,169,${.12+p.z*.22})`;ctx.fillRect(p.x,p.y,1,1);}}
   for(const ring of land){ctx.beginPath();let pen=false;for(const [lon,lat] of ring){const p=project(lon,lat,rotation);if(p.z>0){if(pen)ctx.lineTo(p.x,p.y);else ctx.moveTo(p.x,p.y);pen=true;}else pen=false;}ctx.strokeStyle='#e67aa78c';ctx.stroke();}
   for(const [lon,lat] of landDots){const p=project(lon,lat,rotation);if(p.z>.03){const shimmer=.7+.3*Math.sin(lon*8+lat+t*1.3);ctx.fillStyle=`rgba(255,135,190,${(.3+p.z*.6)*shimmer})`;ctx.beginPath();ctx.arc(p.x,p.y,.65+p.z*.55,0,Math.PI*2);ctx.fill();}}
   // Capital-city lights use geographic coordinates rather than random ocean points.
   const capitals=[[71.43,51.17],[-77.04,38.91],[-.13,51.51],[2.35,48.86],[13.41,52.52],[12.50,41.90],[-3.70,40.42],[37.62,55.75],[32.86,39.93],[31.24,30.04],[46.68,24.71],[51.39,35.69],[69.24,41.30],[77.21,28.61],[116.41,39.90],[139.69,35.68],[126.98,37.57],[100.50,13.76],[103.82,1.35],[36.82,-1.29],[28.23,-25.75],[-47.88,-15.79],[-99.13,19.43],[-75.70,45.42]];
   capitals.forEach(([lon,lat],i)=>{const p=project(lon,lat,rotation);if(p.z>.05){dot(p.x,p.y,2.2+p.z*.7,.8+.2*Math.sin(t*.8+i)**2);ctx.save();ctx.globalAlpha*=.3;ctx.strokeStyle='#ff81ba';ctx.beginPath();ctx.arc(p.x,p.y,5+p.z*2,0,Math.PI*2);ctx.stroke();ctx.restore();}});
   const astana=project(71.43,51.17,rotation),boston=project(-71.06,42.36,rotation);
   const mark=(p:typeof astana,label:string)=>{dot(p.x,p.y,5.5);ctx.fillStyle='#ffc0dc';ctx.font='18px Helvetica, Arial';ctx.fillText(label,p.x+10,p.y-12);};
   if(t>1 && t<3.7 && astana.z>0)mark(astana,'ASTANA');
   const progress=Math.min(1,Math.max(0,(t-1.4)/2.6));
   if(progress>0){let tip:{x:number,y:number}|undefined;ctx.beginPath();for(let i=0;i<=80*progress;i++){const u=i/80;const a=71.43*D,b=51.17*D,c=-71.06*D,d=42.36*D;const v=[Math.cos(b)*Math.cos(a),Math.sin(b),Math.cos(b)*Math.sin(a)],w=[Math.cos(d)*Math.cos(c),Math.sin(d),Math.cos(d)*Math.sin(c)];const omega=Math.acos(v.reduce((sum,x,k)=>sum+x*w[k],0));const p=v.map((x,k)=>(Math.sin((1-u)*omega)*x+Math.sin(u*omega)*w[k])/Math.sin(omega));const q=project(Math.atan2(p[2],p[0])/D,Math.asin(p[1])/D,rotation,radius+Math.sin(u*Math.PI)*38);if(i===0)ctx.moveTo(q.x,q.y);else ctx.lineTo(q.x,q.y);tip=q;}ctx.strokeStyle='#ff4a9f55';ctx.lineWidth=7;ctx.shadowColor='#ff459c';ctx.shadowBlur=24;ctx.stroke();ctx.strokeStyle='#ffe0ef';ctx.lineWidth=2;ctx.stroke();ctx.shadowBlur=0;if(tip)dot(tip.x,tip.y,5);}
   if(t>4){mark(boston,'BOSTON');const pulse=(t-4)/1.1;if(pulse<1){ctx.beginPath();ctx.arc(boston.x,boston.y,8+pulse*65,0,Math.PI*2);ctx.strokeStyle=`rgba(255,157,203,${1-pulse})`;ctx.stroke();}}
   ctx.restore();
   // Convert Boston to SVG coordinates so the cube and unfolding layers share one origin.
   const canvasBox=canvas.getBoundingClientRect(),svgBox=stack.getBoundingClientRect();
   const svgScale=Math.min(svgBox.width/635,svgBox.height/540);
   const offsetY=(svgBox.height-540*svgScale)/2;
   const originY=(canvasBox.top-svgBox.top+boston.y*canvasBox.width/size-offsetY)/svgScale+35;
   const lift=ease((t-4.25)/2.1)*85;
   const svgLift=lift*canvasBox.width/size/svgScale;
   const split=ease((t-5.35)/1.45);
   if(t>4.2 && t<7.5){
    const growth=ease((t-4.2)/.75),alpha=1-ease((t-6.5)/1);
    ctx.save();ctx.globalAlpha=alpha;ctx.shadowColor='#ff4199';ctx.shadowBlur=30;
    const x=boston.x,y=boston.y-lift,r=8+growth*25;
    const face=(points:number[][],fill:string)=>{ctx.beginPath();points.forEach(([px,py],i)=>i?ctx.lineTo(px,py):ctx.moveTo(px,py));ctx.closePath();ctx.fillStyle=fill;ctx.fill();ctx.strokeStyle='#ffd5ea';ctx.lineWidth=1;ctx.stroke();};
    // The cube's faces separate into four diamond fragments before expanding into layers.
    for(let i=0;i<4;i++){const cy=y+(i-1.5)*split*36,spread=r*(1+split*.6);face([[x,cy-spread*.5],[x+spread,cy],[x,cy+spread*.5],[x-spread,cy]],i===0?'#fff0fa':'#ff78b9aa');}
    if(split<1){ctx.globalAlpha*=1-split;face([[x-r,y],[x,y+r*.5],[x,y+r*1.4],[x-r,y+r*.9]],'#d53682');face([[x+r,y],[x,y+r*.5],[x,y+r*1.4],[x+r,y+r*.9]],'#ff91c5');}
    ctx.restore();
   }
   layers.forEach((layer,i)=>{
    const unfold=ease((t-5.65-i*.28)/2.1),scale=.055+.945*unfold;
    const targetY=165+i*100;
    const x=225;
    const y=originY-svgLift+(targetY-originY+svgLift)*unfold;
    layer.style.opacity=String(ease((t-5.6-i*.28)/.55));
    layer.setAttribute('transform',`translate(${x} ${y}) scale(${scale}) translate(-225 ${-targetY})`);
   });
   frame=requestAnimationFrame(tick);
  };frame=requestAnimationFrame(tick);
 }
 motion.addEventListener('change',()=>{if(motion.matches)stop();});
 window.addEventListener('pagehide',stop,{once:true});
}
</script>
<style>
.hero-systems { width:100%; max-width:620px; aspect-ratio:580/600; position:relative; isolation:isolate; }
canvas,.system-stack { position:absolute; inset:0; width:100%; height:100%; }
canvas { --globe-width:calc(100% + 110px); --globe-left:-90px; width:calc(var(--globe-width) * 1.6666667); left:calc(var(--globe-left) - var(--globe-width) / 3); height:auto; aspect-ratio:1600/700; top:0; }
canvas[hidden] { display:none; }
canvas { pointer-events:none; mask-image:linear-gradient(to bottom,#000 75%,transparent 100%); }
.system-stack { overflow:visible; scale:1; transform-origin:43% 50%; }
.system-layer > path:first-child { filter:drop-shadow(0 0 5px #ff5ca980); }
.stack-core { filter:drop-shadow(0 0 18px #ff6caf); }
.ambient-particle { animation:particle-drift 5s ease-in-out infinite alternate; animation-delay:calc(var(--particle)*-.7s); }
@keyframes particle-drift { to { transform:translate(7px,-14px); opacity:.3; } }
.connection-node { filter:drop-shadow(0 0 5px #ff4ba2); }
.floating-stack { transform:none; }
.stack-core { animation:core-glow 3s ease-in-out infinite alternate; }
/* The canvas cube and SVG fragments are driven by the same animation clock. */
.is-playing .floating-stack { animation:none; }
.is-playing .system-details,.is-playing .stack-core { animation:detail-arrive 1.1s 7.5s both; }
.is-playing .system-layer text { animation:detail-arrive .8s 8.1s both; }
@keyframes detail-arrive { from { opacity:0; } to { opacity:1; } }

@keyframes core-glow { to { opacity:.65; } }
@media (min-width:651px) and (max-width:1100px) { canvas { --globe-width:calc(100% + 40px); --globe-left:-20px; } }
@media (max-width:650px) { .system-stack { scale:1; } .hero-systems { max-width:460px; margin-inline:auto; } canvas { --globe-width:100%; --globe-left:0px; } }
@media (prefers-reduced-motion:reduce) { *, .floating-stack,.stack-core { animation:none!important; } canvas { display:none; } }
</style>
