---
interface Props { onHome?: boolean; }
const { onHome = false } = Astro.props;
const home = onHome ? '' : import.meta.env.BASE_URL;
const navigation = [ ['Home', 'introduction'], ['About', 'about'], ['Projects', 'projects'], ['Experience', 'experience'], ['Skills', 'skills'], ['Education', 'education'], ['Contact', 'contact'] ];
---
  <header class="site-header">
    <div class="header-inner">
      <nav aria-label="Main navigation">
        {navigation.map(([label, id]) => <a href={`${home}#${id}`}>{label}</a>)}
      </nav>

    </div>
  </header>
