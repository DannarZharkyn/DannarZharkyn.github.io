---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { project: Project; large?: boolean; }
const { project, large = false } = Astro.props;
---
<div class:list={['project-preview', project.visual, { 'case-visual': large }]}>
  {project.image && project.visual === 'fit-phone' ? <div class="fit-phone-window"><Image src={project.image} alt="Terrier Fit app displayed inside a phone" widths={[800, 1536]} sizes="1536px" format="webp" loading={large ? 'eager' : 'lazy'} /></div> : project.image ? <Image src={project.image} alt={project.imageAlt} widths={large ? [600, 1000, 1400] : [400, 800]} sizes={large ? '(max-width: 800px) 100vw, 560px' : '(max-width: 650px) calc(100vw - 48px), (max-width: 1000px) 45vw, 280px'} format="webp" loading={large ? 'eager' : 'lazy'} /> : project.visual !== 'mobility' ? <svg viewBox="0 0 400 250" role="img" aria-label={`${project.name} concept illustration`}>
    <rect width="400" height="250" fill="#f8e8ee" />
    {project.visual === 'fitness' ? <><circle cx="200" cy="125" r="73" fill="none" stroke="#e6abc1" stroke-width="18" /><path d="M87 131h68l20-40 30 72 24-44h84" fill="none" stroke="#292329" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></> : <><path d="M62 65h190v98H120l-34 27v-27H62Z" fill="#292329" /><path d="M169 101h169v85h-24v25l-34-25H169Z" fill="#ecacc5" stroke="#f8e8ee" stroke-width="4" /><path d="M196 131h111m-111 24h76" stroke="#292329" stroke-width="5" stroke-linecap="round" /></>}
  </svg> :
<svg viewBox="0 0 400 250" role="img" aria-label="Schematic illustration of a four-way traffic intersection">
                    <rect width="400" height="250" fill="#e6e3e5"/>
                    <g fill="#d4cdd1"><rect x="18" y="18" width="118" height="48" rx="4"/><rect x="264" y="18" width="118" height="48" rx="4"/><rect x="18" y="184" width="118" height="48" rx="4"/><rect x="264" y="184" width="118" height="48" rx="4"/></g>
                    <path d="M0 125H400M200 0V250" stroke="#575058" stroke-width="80"/>
                    <path d="M0 125H155M245 125H400M200 0V80M200 170V250" stroke="#e9e1e6" stroke-width="2" stroke-dasharray="12 10"/>
                    <g fill="#edabc5"><rect x="70" y="139" width="25" height="12" rx="3"/><rect x="112" y="139" width="25" height="12" rx="3"/><rect x="213" y="36" width="12" height="25" rx="3"/></g>
                    <g fill="#f8f5f7"><rect x="293" y="99" width="25" height="12" rx="3"/><rect x="175" y="193" width="12" height="25" rx="3"/></g>
                    <g fill="#a34f72"><circle cx="148" cy="74" r="5"/><circle cx="252" cy="176" r="5"/></g>
                  </svg>}
</div>
