---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { evidence: NonNullable<Project['evidence']>; }
const { evidence } = Astro.props;
---
<section class="research-architecture" aria-labelledby="architecture-title">
  <div class="container">
    <h2 id="architecture-title">System Architecture</h2>
    <p class="research-intro">Web, mobile, and embedded control connected through Firebase.</p>
    <ol class="architecture-steps">
      {evidence.architecture.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}
    </ol>
  </div>
</section>
<section class="research-gallery light-panel" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title">Inside the Project</h2>
    <p class="research-intro">Interfaces and components from the original thesis. The recovered navigation app uses the phone’s GPS; the separate GPS module is shown as thesis hardware.</p>
    <div class="research-figures">
      {evidence.figures.map(figure => <figure class:list={{ 'portrait-figure': figure.portrait }}>
        <div class="research-image"><Image src={figure.image} alt={figure.alt} widths={[400, 800, 1200]} sizes="(max-width: 650px) 40vw, 220px" format="webp" loading="lazy" /></div>
        <figcaption>{figure.caption}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
