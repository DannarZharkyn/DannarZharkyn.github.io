---
import { Image } from 'astro:assets';
import portrait from '../assets/dannar-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { education } from '../data/education';
const navigation = [ ['Home', 'introduction'], ['About', 'about'], ['Projects', 'projects'], ['Experience', 'experience'], ['Skills', 'skills'], ['Education', 'education'], ['Contact', 'contact'] ];
const process = ['Problem', 'My role', 'Process', 'Engineering & design decisions', 'Implementation', 'Results'];
---
<BaseLayout title="Dannar Zharkyn | Engineering Portfolio" description="Engineering portfolio of Dannar Zharkyn, a Systems Engineering MS candidate at Boston University.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="#introduction" aria-label="Dannar Zharkyn — home">DZ</a>
      <nav aria-label="Main navigation">
        {navigation.map(([label, id]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <span class="header-note" aria-hidden="true">PORTFOLIO / 01</span>
    </div>
  </header>

  <main id="main">
    <section class="hero dark-panel" id="introduction" aria-labelledby="intro-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Engineering portfolio</p>
          <h1 id="intro-title">Dannar<br /><span>Zharkyn</span></h1>
          <p class="hero-label">Systems Engineering <span aria-hidden="true">·</span> MS candidate</p>
          <p class="hero-description">A Systems Engineering MS candidate at Boston University.</p>
          <div class="hero-actions">
            <a class="button" href="#projects">View my work <span aria-hidden="true">→</span></a>
            <a class="button button-outline" href="#contact">Get in touch</a>
          </div>
          <div class="hero-links">
            {profile.linkedin && <a href={profile.linkedin} aria-label="Dannar Zharkyn on LinkedIn">LinkedIn <span aria-hidden="true">↗</span></a>}
            <a href={profile.github} aria-label="Dannar Zharkyn on GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.09c-3.12.68-3.78-1.33-3.78-1.33-.5-1.29-1.24-1.64-1.24-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.49-.29-5.11-1.25-5.11-5.54 0-1.22.44-2.22 1.15-3-.11-.29-.5-1.43.11-2.97 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.22 2.68.11 2.97.72.78 1.15 1.78 1.15 3 0 4.3-2.62 5.25-5.12 5.53.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg><span>GitHub</span></a>
            <span class="link-divider" aria-hidden="true"></span>
            {profile.resume ? <a href={profile.resume}>View resume ↗</a> : <span class="pending-link">Resume coming soon</span>}
          </div>
        </div>
        <figure class="portrait-frame">
          <Image src={portrait} alt="Portrait of Dannar Zharkyn" widths={[400, 800, 1200]} sizes="(max-width: 650px) min(340px, 100vw - 48px), 360px" format="webp" loading="eager" fetchpriority="high" class="hero-portrait" />
          <figcaption>Boston University <span>Systems Engineering</span></figcaption>
        </figure>
        <div class="hero-margin" aria-hidden="true"><span>01</span><span class="margin-line"></span><span>07</span></div>
      </div>
      <div class="container hero-bottom"><span>Systems. Ideas. Possibilities.</span><a href="#projects">Explore the portfolio <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="projects-section light-panel" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-top"><div><p class="eyebrow">01 / The work</p><h2 id="projects-title">Featured projects</h2></div><span class="section-note">Case studies in preparation</span></div>
        <div class="project-stage">
          <div class="project-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="art-cross">+</span><span class="art-caption">FROM QUESTION TO OUTCOME</span></div>
          <div class="project-intro"><span class="status-label"><span aria-hidden="true"></span> Portfolio in progress</span><h3>The work behind<br />the outcome.</h3><p>Project case studies are coming soon, with a closer look at the problem, the decisions, and the results.</p><span class="small-note">Real projects. Documented process.</span></div>
        </div>
        <ol class="process" aria-label="Future case-study structure">{process.map((step, index) => <li><span>0{index + 1}</span>{step}</li>)}</ol>
      </div>
    </section>

    <div class="details-grid">
      <section class="about-section dark-panel detail-panel" id="about" aria-labelledby="about-title">
        <p class="eyebrow">02 / Introduction</p><h2 id="about-title">About me</h2>
        <p class="about-lead">I’m Dannar, a Systems Engineering MS candidate at Boston University.</p>
        <p class="muted">This portfolio is taking shape. Project stories, experience, and the process behind the work will be added here.</p>
        <div class="about-bottom">{profile.resume ? <a class="button" href={profile.resume}>View resume →</a> : <span class="resume-note">Resume <span>Coming soon</span></span>}<span class="editorial-note" aria-hidden="true">Systems.<br />People.<br />Possibilities.</span></div>
      </section>
      <section class="skills-section light-panel detail-panel" id="skills" aria-labelledby="skills-title">
        <p class="eyebrow">03 / Toolkit</p><h2 id="skills-title">Skills</h2>
        <div class="toolkit-symbols" aria-hidden="true"><span>&lt;/&gt;</span><span>⌘</span><span>◇</span></div>
        <h3>Skills with a story behind them.</h3><p class="muted">Technical tools and capabilities will be added alongside the projects that demonstrate them.</p><p class="section-note skills-note">Details coming soon</p>
      </section>
      <section class="experience-section dark-panel detail-panel" id="experience" aria-labelledby="experience-title">
        <p class="eyebrow">04 / Experience</p><h2 id="experience-title">Experience</h2>
        <div class="timeline"><div class="timeline-item"><h3>Experience details coming soon.</h3><p>Roles, responsibilities, and contributions will be documented here.</p></div></div>
      </section>
    </div>

    <section class="education-section light-panel" id="education" aria-labelledby="education-title">
      <div class="container">
        <div class="section-top"><div><p class="eyebrow">05 / Education</p><h2 id="education-title">Education</h2></div><span class="section-note">Degrees & international exchanges</span></div>
        <div class="education-grid">
          {education.map(entry => (
            <article class="education-card">
              <span class="degree-label">{entry.degree}</span>
              <h3>{entry.institution}</h3>
              <p class="education-field">{entry.field}</p>
              <p class="education-dates">{entry.dates}</p>
              <ul class="education-bullets">{entry.highlights.map(item => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div><p class="eyebrow">06 / Contact</p><h2 id="contact-title">Let’s connect.</h2><p>Connect with me on LinkedIn or explore my work on GitHub.</p></div>
        <div class="contact-links">
          <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
          {profile.linkedin ? <a href={profile.linkedin}>LinkedIn ↗</a> : <span>LinkedIn <small>Coming soon</small></span>}
          <div class="contact-emails" aria-label="Email addresses">
            {profile.emails.map(email => <a href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>)}
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="container"><a class="wordmark" href="#introduction" aria-label="Dannar Zharkyn — back to top">DZ</a><p>© {new Date().getFullYear()} Dannar Zharkyn</p><a href="#introduction">Back to top ↑</a></div></footer>
</BaseLayout>
