---
import { Image } from 'astro:assets';
import portrait from '../assets/dannar-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { education } from '../data/education';
import { projects } from '../data/projects';
const navigation = [ ['Home', 'introduction'], ['About', 'about'], ['Projects', 'projects'], ['Experience', 'experience'], ['Skills', 'skills'], ['Education', 'education'], ['Contact', 'contact'] ];
---
<BaseLayout title="Dannar Zharkyn | Engineering Portfolio" description="Engineering portfolio of Dannar Zharkyn, a Systems Engineering MS candidate at Boston University.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href="#introduction" aria-label="Dannar Zharkyn — home">DZ</a>
      <nav aria-label="Main navigation">
        {navigation.map(([label, id]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

    </div>
  </header>

  <main id="main">
    <section class="hero dark-panel" id="introduction" aria-labelledby="intro-title">
      <div class="container hero-grid">
        <div class="hero-copy">

          <h1 id="intro-title">Dannar<br /><span>Zharkyn</span></h1>
          <p class="hero-label">Systems Engineer <span aria-hidden="true">·</span> Product Builder</p>
          <p class="hero-description">A Systems Engineering MS candidate at Boston University.</p>
          <div class="hero-actions">
            <a class="button" href="#projects">View my work <span aria-hidden="true">→</span></a>
            <a class="button button-outline" href="#contact">Get in touch</a>
          </div>
          <div class="hero-links">
            {profile.linkedin && <a href={profile.linkedin} aria-label="Dannar Zharkyn on LinkedIn">LinkedIn <span aria-hidden="true">↗</span></a>}
            <a href={profile.github} aria-label="Dannar Zharkyn on GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.09c-3.12.68-3.78-1.33-3.78-1.33-.5-1.29-1.24-1.64-1.24-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.49-.29-5.11-1.25-5.11-5.54 0-1.22.44-2.22 1.15-3-.11-.29-.5-1.43.11-2.97 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.22 2.68.11 2.97.72.78 1.15 1.78 1.15 3 0 4.3-2.62 5.25-5.12 5.53.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg><span>GitHub</span></a>
            <span class="link-divider" aria-hidden="true"></span>
            {profile.resume ? <a href={profile.resume}>View resume ↗</a> : <span class="pending-link">Resume coming soon</span>}
          </div>
        </div>
        <div class="systems-visual" aria-hidden="true">

          <svg viewBox="0 0 440 440" fill="none">
            <defs><pattern id="systems-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" stroke="#f3b8cc" stroke-opacity=".07"/></pattern></defs>
            <rect width="440" height="440" fill="url(#systems-grid)"/>
            <circle cx="220" cy="220" r="162" stroke="#f3b8cc" stroke-opacity=".18" stroke-dasharray="3 8"/>
            <circle cx="220" cy="220" r="110" stroke="#f3b8cc" stroke-opacity=".1"/>
            <g stroke="#f3b8cc" stroke-opacity=".55">
              <path d="M80 120H160V190M280 250V320H360M80 320H150V250M280 190V120H360"/>
              <path d="M220 58V160M220 280V382" stroke-dasharray="4 6"/>
              <rect x="160" y="160" width="120" height="120" rx="6" fill="#f3b8cc" fill-opacity=".04"/>
              <rect x="178" y="178" width="84" height="84" rx="3" stroke-opacity=".2"/>
              <path d="M207 220H233M220 207V233"/>
            </g>
            <g fill="#f3b8cc"><circle cx="80" cy="120" r="4"/><circle cx="360" cy="120" r="4"/><circle cx="80" cy="320" r="4"/><circle cx="360" cy="320" r="4"/><circle cx="220" cy="58" r="3"/><circle cx="220" cy="382" r="3"/></g>
          </svg>

        </div>
      </div>
    </section>

    <section class="about-section dark-panel" id="about" aria-labelledby="about-title">
      <div class="container about-grid">
        <figure class="portrait-frame">
          <Image src={portrait} alt="Portrait of Dannar Zharkyn" widths={[400, 800, 1200]} sizes="(max-width: 650px) min(340px, 100vw - 48px), 360px" format="webp" loading="lazy" class="about-portrait" />
          <figcaption>Boston University <span>Systems Engineering</span></figcaption>
        </figure>
        <div class="about-copy">
          <h2 id="about-title">About me</h2>
          <p class="about-lead">I’m Dannar, a Systems Engineering MS candidate at Boston University, with a background in Computer Engineering and Software.</p>
          <p class="muted">My work connects software, hardware, and systems modeling—from robotic-assistant controls and automated irrigation to multi-agent urban mobility analysis.</p>
          <p class="muted">I’m interested in how individual components come together to build useful products and better systems.</p>
          <div class="about-bottom">{profile.resume ? <a class="button" href={profile.resume}>View resume →</a> : <span class="resume-note">Resume <span>Coming soon</span></span>}</div>
        </div>
      </div>
    </section>

    <section class="projects-section light-panel" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-top"><h2 id="projects-title">Featured projects</h2></div>
        <div class="project-grid">
          {projects.map(project => (
            <article class="project-card">
              <div class={`project-preview ${project.visual}`}>
                {project.image ? <Image src={project.image} alt={project.imageAlt} widths={[400, 800]} sizes="(max-width: 650px) calc(100vw - 48px), (max-width: 1000px) 45vw, 280px" format="webp" loading="lazy" /> :
                  <svg viewBox="0 0 400 250" role="img" aria-label="Schematic illustration of a four-way traffic intersection">
                    <rect width="400" height="250" fill="#e6e3e5"/>
                    <g fill="#d4cdd1"><rect x="18" y="18" width="118" height="48" rx="4"/><rect x="264" y="18" width="118" height="48" rx="4"/><rect x="18" y="184" width="118" height="48" rx="4"/><rect x="264" y="184" width="118" height="48" rx="4"/></g>
                    <path d="M0 125H400M200 0V250" stroke="#575058" stroke-width="80"/>
                    <path d="M0 125H155M245 125H400M200 0V80M200 170V250" stroke="#e9e1e6" stroke-width="2" stroke-dasharray="12 10"/>
                    <g fill="#edabc5"><rect x="70" y="139" width="25" height="12" rx="3"/><rect x="112" y="139" width="25" height="12" rx="3"/><rect x="213" y="36" width="12" height="25" rx="3"/></g>
                    <g fill="#f8f5f7"><rect x="293" y="99" width="25" height="12" rx="3"/><rect x="175" y="193" width="12" height="25" rx="3"/></g>
                    <g fill="#a34f72"><circle cx="148" cy="74" r="5"/><circle cx="252" cy="176" r="5"/></g>
                  </svg>}
              </div>
              <div class="project-card-body">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <ul class="project-tags" aria-label={`${project.name} categories`}>{project.tags.map(tag => <li>{tag}</li>)}</ul>
                <div class="project-card-links">
                  {project.demo && <a href={project.demo} aria-label={`Visit ${project.name}`}>Visit project <span aria-hidden="true">↗</span></a>}
                  {project.repository && <a href={project.repository} aria-label={`${project.name} on GitHub`}>GitHub <span aria-hidden="true">↗</span></a>}
                  {!project.demo && !project.repository && <span class="project-unavailable">Preview link coming soon</span>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="details-grid">
      <section class="skills-section light-panel detail-panel" id="skills" aria-labelledby="skills-title">
        <h2 id="skills-title">Skills</h2>
        <div class="toolkit-symbols" aria-hidden="true"><span>&lt;/&gt;</span><span>⌘</span><span>◇</span></div>
        <h3>Skills with a story behind them.</h3><p class="muted">Technical tools and capabilities will be added alongside the projects that demonstrate them.</p><p class="section-note skills-note">Details coming soon</p>
      </section>
      <section class="experience-section dark-panel detail-panel" id="experience" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        <div class="timeline"><div class="timeline-item"><h3>Experience details coming soon.</h3><p>Roles, responsibilities, and contributions will be documented here.</p></div></div>
      </section>
    </div>

    <section class="education-section light-panel" id="education" aria-labelledby="education-title">
      <div class="container">
        <div class="section-top"><div><h2 id="education-title">Education</h2></div><span class="section-note">Degrees & international exchanges</span></div>
        <div class="education-grid">
          {education.map(entry => (
            <article class="education-card">
              <span class="degree-label">{entry.degree}</span>
              <h3>{entry.institution}</h3>
              <p class="education-field">{entry.field}</p>
              <p class="education-dates">{entry.dates}</p>
              <ul class="education-bullets">{entry.highlights.map(item => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div><h2 id="contact-title">Let’s connect.</h2><p>Connect with me on LinkedIn or explore my work on GitHub.</p></div>
        <div class="contact-links">
          <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
          {profile.linkedin ? <a href={profile.linkedin}>LinkedIn ↗</a> : <span>LinkedIn <small>Coming soon</small></span>}
          <div class="contact-emails" aria-label="Email addresses">
            {profile.emails.map(email => <a href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>)}
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="container"><p>© {new Date().getFullYear()} Dannar Zharkyn</p></div></footer>
</BaseLayout>
